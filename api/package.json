    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.0"
  }
}
