# Copie para .env.production (NUNCA versione esse arquivo) e preencha. Cada valor secreto deve ser único e aleatório.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Obrigatórios ---------------------------------------------------------------
DOMAIN=app.seudominio.com.br          # o DNS (registro A/AAAA) já deve apontar para este servidor; portas 80 e 443 abertas
ACME_EMAIL=voce@seudominio.com.br     # aviso de expiração do certificado (Let's Encrypt)
# Alternativa privada (Tailscale, sem expor na internet): descomente e ajuste. DOMAIN vira o nome MagicDNS (xxx.ts.net).
#BIND_IP=100.x.x.x                                 # tailscale ip -4 — portas 80/443 só nessa interface
#CADDYFILE=./ops/caddy/Caddyfile.tailscale         # certificado: tailscale cert --cert-file ops/tailscale-certs/DOMAIN.crt --key-file ops/tailscale-certs/DOMAIN.key DOMAIN
POSTGRES_PASSWORD=                    # openssl rand -base64 24 (evite caracteres @ : / % # na senha)
DATA_ENCRYPTION_KEY=                  # openssl rand -base64 32  — GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela os dados criptografados são irrecuperáveis

# --- IA (pelo menos uma) ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

APP_TIMEZONE=America/Sao_Paulo

# --- Open Finance (opcional) --------------------------------------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=                # openssl rand -hex 32 (mínimo 24 caracteres)
PLUGGY_WEBHOOK_URL=                   # https://SEU_DOMINIO/webhooks/pluggy

# --- Lembretes no celular (opcional) ----------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
