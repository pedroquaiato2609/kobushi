# Chaves dos provedores de IA. Preencha pelo menos uma.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fuso usado para "hoje", agenda e rotina (horários são gravados como hora local).
APP_TIMEZONE=America/Sao_Paulo

# Open Finance real: crie uma aplicação em https://dashboard.pluggy.ai
# A aplicação precisa ter acesso a bancos reais. Não use credenciais sandbox.
# Chaves somente no servidor, nunca em variáveis VITE_ nem no chat.
# Após preencher: docker compose up -d --force-recreate api
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo exclusivo do receptor (gere 32 bytes aleatórios). O registro usa cabeçalho via API.
PLUGGY_WEBHOOK_SECRET=

# --- Lembretes no celular (opcional) ---------------------------------------------
# Notificações push (PWA). Gere as chaves com:  docker compose exec api npx web-push generate-vapid-keys
# Push só funciona em HTTPS (ou localhost). Para usar no celular, exponha o app por um túnel HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@example.com

# WhatsApp via Twilio (opcional). O número de destino é configurado em Configurações > Notificações.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
